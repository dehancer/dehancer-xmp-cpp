@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET dehancer_common_cpp::dehancer_common_cpp)
    find_dependency(dehancer_common_cpp CONFIG)
endif()
if(NOT TARGET Exiv2::exiv2lib)
    find_dependency(exiv2 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/dehancer_xmp_cppTargets.cmake")
check_required_components(dehancer_xmp_cpp)
